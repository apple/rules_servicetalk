load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

exports_files([
    "extract_proto.bzl",
])

bzl_library(
    name = "docs",
    srcs = glob(["*.bzl"]) + [
        # We have to include this file this way to avoid a circular dependency
        "@bazel_tools//tools:bzl_srcs",
    ],
    visibility = [
        "//:__subpackages__",
    ],
    deps = [
        "//proto/private:docs",
    ],
)
