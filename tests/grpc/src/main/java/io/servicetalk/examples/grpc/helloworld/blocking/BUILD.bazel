load("@rules_java//java:defs.bzl", "java_binary", "java_library")

java_library(
    name = "BlockingHelloWorldClient",
    srcs = ["BlockingHelloWorldClient.java"],
    resources = ["//src/main/resources:log4j.xml"],
    deps = [
        "//src/main/proto:helloworld",
        "@maven//:io_servicetalk_servicetalk_grpc_netty",
    ],
)

java_binary(
    name = "blocking_client",
    main_class = "io.servicetalk.examples.grpc.helloworld.blocking.BlockingHelloWorldClient",
    runtime_deps = [
        ":BlockingHelloWorldClient",
        "@maven//:org_slf4j_slf4j_simple",
    ],
)

java_library(
    name = "BlockingHelloWorldServer",
    srcs = ["BlockingHelloWorldServer.java"],
    resources = ["//src/main/resources:log4j.xml"],
    runtime_deps = [
        "@maven//:org_slf4j_slf4j_simple",
    ],
    deps = [
        "//src/main/proto:helloworld",
        "@maven//:io_servicetalk_servicetalk_grpc_netty",
    ],
)

java_binary(
    name = "blocking_server",
    main_class = "io.servicetalk.examples.grpc.helloworld.blocking.BlockingHelloWorldServer",
    runtime_deps = [
        ":BlockingHelloWorldServer",
        "@maven//:org_slf4j_slf4j_simple",
    ],
)
