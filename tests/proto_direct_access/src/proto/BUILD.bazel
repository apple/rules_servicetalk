load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_java//java:defs.bzl", "java_library")
load("@rules_servicetalk//proto:defs.bzl", "java_proto_library", "proto_library")

proto_library(
    name = "person_proto",
    srcs = ["person.proto"],
)

