module(name = "rules_servicetalk_tests_protobuf")

bazel_dep(name = "rules_servicetalk", version = "0.0.0")
local_path_override(
    module_name = "rules_servicetalk",
    path = "../../",
)

bazel_dep(name = "rules_jvm_external", version = "6.10")

#### Protoc compiler ####
protobuf_version = "25.8"

#### Maven Jars ####
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        "com.google.protobuf:protobuf-java:3." + protobuf_version,
        "com.google.protobuf:protobuf-java-util:3." + protobuf_version,
    ],
    fail_if_repin_required = True,
    fetch_sources = True,
    known_contributing_modules = [
        "protobuf",
        "rules_servicetalk_tests_protobuf",
    ],
    lock_file = ":maven_install.json",
)
use_repo(maven, "maven")
