load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_servicetalk//proto:defs.bzl", "zip_protos")

proto_library(
    name = "uses_googleapis_proto",
    srcs = ["uses_googleapis.proto"],
    deps = [
        "@googleapis//google/api:field_behavior_proto",
    ],
)

build_test(
    name = "googleapis_test",
    targets = [":uses_googleapis_proto"],
)

zip_protos(
    name = "googleapis_zip",
    out = "googleapis_test_protos.zip",
    deps = ["uses_googleapis_proto"],
)

build_test(
    name = "googleapis_zip_test",
    targets = [":googleapis_zip"],
)
